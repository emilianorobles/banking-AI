# Copy this file to .streamlit/secrets.toml and paste your own key from APIKey.xlsx.
# secrets.toml is gitignored. Never commit a real key.
GENAILAB_API_KEY = "sk-your-key-here"

# ---------------------------------------------------------------------------
# Optional: secondary chat provider.
#
# The TCS endpoint is a shared internal service and has returned
#   503 "the authentication database is temporarily unreachable"
# during working hours. Set a key here and chat falls back to that provider when the
# primary fails, after the recorded cache and before giving up.
#
# CHAT ONLY. Groq serves no embedding model, so retrieval still depends on the primary
# or on data/cached_embeddings.json. Citations survive for the recorded scenarios; a
# brand-new transaction gets no precedents while the primary is down.
#
# Free tier is 1,000 requests/day and 8,000 tokens/minute -- ample for a demo, too tight
# to run the full evaluation harness through.
#
# Get one at https://console.groq.com. Leave unset to disable the fallback entirely.
# ---------------------------------------------------------------------------
# FALLBACK_API_KEY = "gsk_your-key-here"
# FALLBACK_BASE_URL = "https://api.groq.com/openai/v1"
# FALLBACK_CHAT_MODEL = "openai/gpt-oss-120b"
