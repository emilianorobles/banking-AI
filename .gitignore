# Secrets — NEVER commit the API key
.streamlit/secrets.toml
.env

# Scratch files that have held a live key at some point.
# The connectivity-test snippet from the organizer guides hardcodes one.
chatbot.txt
test_key.py

# Generated state — regenerated by `python -m core.seed`
*.db
*.db-wal
*.db-shm

# Rendered notification emails. One per action taken, so they churn on every rehearsal,
# and `seed.seed(reset=True)` wipes the directory anyway. Unlike the caches below there
# is nothing to gain by committing them — they are output, not fallback.
data/outbox/

# NOT ignored, deliberately:
#   data/faiss/                  the built index
#   data/cached_responses.json   recorded model responses
#   data/cached_embeddings.json  recorded query embeddings
# These three are the offline demo fallback. Committing them means the demo runs with
# no network on any machine, without needing the API to rebuild first — which is the
# whole point of having a fallback. They contain only synthetic data and model output,
# no secrets. Total ~1.7 MB.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
